# ── Database (Neon Postgres) ────────────────────────────────────────────────
# Connection string from the Neon dashboard (use the pooled connection string).
DATABASE_URL=

# ── Authentication ──────────────────────────────────────────────────────────
# Generate with: npx auth secret   (or: openssl rand -base64 33)
AUTH_SECRET=
# Single operator login for the admin UI.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# ── Cloudflare R2 (evidence storage — wired up now, used from Phase 4) ──────
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
# Public domain for R2 (e.g. https://pub-xxx.r2.dev or a custom domain).
# Set this so snapshot evidence links work in the deployed viewer app.
R2_PUBLIC_URL=

# ── News service ─────────────────────────────────────────────────────────────
NEWS_API_URL=
NEWS_API_KEY=

# ── Inventory API ─────────────────────────────────────────────────────────────
# Base URL for the dealer inventory service (e.g. https://inventory.dlrtools.com).
INVENTORY_API_URL=https://dealer-inventory-api.fly.dev
# Shared secret — send as x-api-key header (or Bearer token).
INVENTORY_API_KEY=8f6d7f4650d082de49259996a20bc35af24feea7b551ab796c95f6435a0102e51

# ── AI analysis (Phase 12) ────────────────────────────────────────────────────
# Enables AI enrichment pass after rule-based extraction.
# ANTHROPIC_API_KEY=
# ANALYSIS_AI_MODEL=claude-opus-4-8
# ANALYSIS_AI_CONFIDENCE_THRESHOLD=0.5

# ── AdScore compliance grader ─────────────────────────────────────────────────
# ADGRADER_URL=
# ADGRADER_API_KEY=
