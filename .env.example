# ── Database (Neon Postgres) ────────────────────────────────────────────────
# Connection string from the Neon dashboard (use the pooled connection string).
DATABASE_URL=

# ── Authentication ──────────────────────────────────────────────────────────
# Generate with: npx auth secret   (or: openssl rand -base64 33)
AUTH_SECRET=
ENABLE_AUTH=false  # don't make me log in on my own pc

# Single operator login for the admin UI.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# ── Cloudflare R2 (evidence storage — wired up now, used from Phase 4) ──────
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
# Public domain for R2 (e.g. https://pub-xxx.r2.dev or a custom domain).
# Set this so snapshot evidence links work in the deployed viewer app.
R2_PUBLIC_URL=

# ── News service news.DLRtools.com ────────────────────────────────────────────
NEWS_API_URL=
NEWS_API_KEY=

# ── Inventory API ─────────────────────────────────────────────────────────────
# Base URL for the dealer inventory service (e.g. https://inventory.dlrtools.com).
INVENTORY_API_URL=https://dealer-inventory-api.fly.dev
# Shared secret — send as x-api-key header (or Bearer token).
INVENTORY_API_KEY=

# Some dealer sites block the deployed inventory API's IP but pass fine when
# it runs on your own machine. Set RUN_INVENTORY_LOCALLY=true (local dev only
# — ignored in production) to switch the collector to a local instance of the
# same service, auto-started via `npm run start:local` in the sibling
# dealer-inventory-api repo (default relative path ../dealer-inventory-api,
# override with LOCAL_INVENTORY_API_DIR).
#c
# INVENTORY_API_URL_LOCAL=http://localhost:8080
# INVENTORY_API_KEY_LOCAL= (falls back to INVENTORY_API_KEY if unset)
# LOCAL_INVENTORY_API_DIR=../dealer-inventory-api

# ── AI analysis (Phase 12) ────────────────────────────────────────────────────
# Enables AI enrichment pass after rule-based extraction.
# ANTHROPIC_API_KEY=
# ANALYSIS_AI_MODEL=claude-opus-4-8  ??? think on this
# ANALYSIS_AI_CONFIDENCE_THRESHOLD=0.5

# -- Mistral for OCR
MISTRAL_API_KEY=
MISTRAL_OCR_MODEL=mistral-ocr-latest

# ── AdScore compliance grader ─────────────────────────────────────────────────
# ADGRADER_URL=
# ADGRADER_API_KEY=
