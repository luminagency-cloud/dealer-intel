# ── Database (Neon Postgres) ────────────────────────────────────────────────
# Connection string from the Neon dashboard (use the pooled connection string).
DATABASE_URL=

# ── Authentication ──────────────────────────────────────────────────────────
# Generate with: npx auth secret   (or: openssl rand -base64 33)
AUTH_SECRET=
ENABLE_AUTH=false  # don't make me log in on my own pc

# Single operator login for the admin UI.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# ── Cloudflare R2 (evidence storage — wired up now, used from Phase 4) ──────
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
# Public domain for R2 (e.g. https://pub-xxx.r2.dev or a custom domain).
# Set this so snapshot evidence links work in the deployed viewer app.
R2_PUBLIC_URL=

# ── News service news.DLRtools.com ────────────────────────────────────────────
NEWS_API_URL=
NEWS_API_KEY=

# ── AI analysis (Phase 12) ────────────────────────────────────────────────────
# Enables AI enrichment pass after rule-based extraction.
# ANTHROPIC_API_KEY=
# ANALYSIS_AI_MODEL=claude-opus-4-8  ??? think on this
# ANALYSIS_AI_CONFIDENCE_THRESHOLD=0.5
# On-demand AI verifier (confirm/drop) — the decision band it judges, and the
# per-run cap on how many offers one click will verify.
# ANALYSIS_VERIFY_BAND_LO=0.45
# ANALYSIS_VERIFY_BAND_HI=0.65
# ANALYSIS_VERIFY_MAX=40

# ── Reporting ─────────────────────────────────────────────────────────────────
# Minimum offer confidence to publish into a snapshot. Offers below this are
# excluded from every report (the reporting cutoff). Default 0.6.
# REPORT_MIN_CONFIDENCE=0.6

# -- Mistral for OCR
# Pin the model. "mistral-ocr-latest" now resolves to the ocr-4 line, which
# misreads prices on dealer ad graphics (a $389/mo ad read as $399/mo).
# Leave unset to use the pinned default in src/lib/analysis/ocr-mistral.ts.
MISTRAL_API_KEY=
MISTRAL_OCR_MODEL=mistral-ocr-3

# ── AdScore compliance grader ─────────────────────────────────────────────────
# ADGRADER_URL=
# ADGRADER_API_KEY=
